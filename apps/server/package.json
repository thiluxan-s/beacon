    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@beacon/shared": "*",
    "@hono/node-server": "^1.13.7",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.38.3",
    "hono": "^4.6.14",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  }
}
